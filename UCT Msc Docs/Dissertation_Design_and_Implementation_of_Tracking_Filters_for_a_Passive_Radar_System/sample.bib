isbn = {9781538622124},
issn = {19449933},
journal = {IEEE Power and Energy Society General Meeting},
keywords = {Dynamic state estimation (DSE),Innovation/residual-based adaptive estimation,Kalman filter,Measurement noise matching,Process noise scaling},
