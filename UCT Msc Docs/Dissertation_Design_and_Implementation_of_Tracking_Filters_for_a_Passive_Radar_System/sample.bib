journal = {Proceedings of the Mediterranean Electrotechnical Conference - MELECON},
keywords = {Estimation, RTT, TCP, Video, Polynomial filter},
pages = {1581--1585},
title = {{Round-trip time estimation in telecommunication networks using composite expanding and fading memory polynomials}},
year = {2010}
}

