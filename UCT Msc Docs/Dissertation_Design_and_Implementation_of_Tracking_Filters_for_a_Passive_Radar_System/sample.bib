@article{Colone2009,
abstract = {The paper examines the problem of cancellation of direct signal, multipath and clutter echoes in passive bistatic radar (PBR). This problem is exacerbated as the transmitted waveform is not under control of the radar designer and the sidelobes of the ambiguity function can mask targets including those displaced in either (or both) range and Doppler from the disturbance. A novel multistage approach is developed for disturbance cancellation and target detection based on projections of the received signal in a subspace orthogonal to both the disturbance and previously detected targets. The resulting algorithm is shown to be effective against typical simulated scenarios with a limited number of stages, and a version with computational savings is also introduced. Finally its effectiveness is demonstrated with the application to real data acquired with an experimental VHF PBR system. {\textcopyright} 2009 IEEE.},
author = {Colone, Fabiola and O'Hagan, D. W. and Lombardo, P. and Baker, C. J.},
doi = {10.1109/TAES.2009.5089551},
file = {:home/itumeleng/Desktop/UCT/Papers/A_Multistage_Processing_Algorithm_for_Disturbance_Removal_and_Target_Detection_in_Passive_Bistatic_Radar.pdf:pdf},
issn = {00189251},
journal = {IEEE Transactions on Aerospace and Electronic Systems},
keywords = {Algorithm design and analysis,Clutter,Data mining,Doppler effect,Frequency modulation,Signal to noise ratio,Surveillance},
number = {2},
pages = {698--722},
publisher = {IEEE},
title = {{A multistage processing algorithm for disturbance removal and target detection in passive bistatic radar}},
volume = {45},
year = {2009}
}

@article{Golabi2013,
abstract = {This paper discusses the problem of sea target detection in satellite based passive radars. This problem is the consequent of two main factors. The first factor, which is common in all passive radars, is that the transmitter is not under the control of radar designer and its ambiguity function is usually undesirable for radar use, therefore the target is masked by the leakage of reference signal, clutter, and stronger targets. The second and more important problem in sea target detection is that the sea targets cannot be extracted from clutter in Doppler domain due to their close velocity. To overcome these problems, an LS based algorithm is proposed in this paper. In the proposed algorithm the reference signal leakage is attenuated by ECA algorithm, then using a least squares algorithm and a two dimensional cell averaging CFAR, the targets are extracted. Simulation results show that the approach is more effective in compared with the ambiguity function based algorithms in terms of accuracy and resolution. {\textcopyright} 2013 IEEE.},
author = {Golabi, Marziye and Sheikhi, Abbas and Biguesh, Mehrzad},
doi = {10.1109/IranianCEE.2013.6599599},
file = {:home/itumeleng/Downloads/A_new_approach_for_sea_target_detection_in_satellite_based_passive_radar (1).pdf:pdf},
isbn = {9781467356343},
journal = {2013 21st Iranian Conference on Electrical Engineering, ICEE 2013},
keywords = {2D-CACFAR,ECA,LS,PBR,sea target},
pages = {1--5},
publisher = {IEEE},
title = {{A new approach for sea target detection in satellite based passive radar}},
year = {2013}
}


