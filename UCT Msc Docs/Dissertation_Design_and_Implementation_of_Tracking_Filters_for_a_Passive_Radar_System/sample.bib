@article{Pasculli2013,
abstract = {This paper presents a tracking algorithm for bistatic DVB-T passive radar based on the Extended Kalman Filter (EKF), exploiting measurement of bistatic range and bistatic velocity of a target. Also the direction of arrival of the target is estimated through beamforming and then used in the tracking model. The algorithm has been tested and validated by using both simulated and real data. The Extended Kalman Filter is then used to obtain accurate and robust results. {\textcopyright} 2013 German Inst of Navigation.},
