@inbook{Hoffman,
author = {Candy, James V.},
publisher = {John Wiley \& Sons, Ltd},
isbn = {9781119125495},
title = {Particle-Based Bayesian State–Space Processors},
booktitle = {Bayesian Signal Processing},
chapter = {7},
pages = {253-326},
doi = {https://doi.org/10.1002/9781119125495.ch7},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781119125495.ch7},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781119125495.ch7},
year = {2016},
keywords = {bootstrap filter, generic sampling-importance-resampling processor, generic state-space particle filter, inherent Markovian structure, particle-based Bayesian state-space processors},
abstract = {Abstract This chapter explains particle-based processors using the state-space representation of signals and shows how they evolve from the Bayesian perspective using their inherent Markovian structure along with importance sampling techniques as basic construct. It first introduces the generic state-space particle filter (SSPF) and investigates some of its inherent distributions and implementation requirements. The chapter explores a generic sampling-importance-resampling (SIR) processor and then perhaps its most popular form, the 'bootstrap' particle filter. Next, it investigates the resampling problem and some of the more popular resampling techniques also incorporated into the bootstrap filter from necessity. The chapter discusses improvements to the bootstrap approach attempting to approximate the minimum variance proposal. These methods included the auxiliary, regularized, MCMC and linearized algorithms. Finally, the chapter explains the application of these processors to a variety of problems and the evaluation of their performance using statistical testing as part of the design methodology.}
}


