@article{Guldogan2014,
abstract = {In this paper, we address the problem of multi-target detection and tracking over a network of separately located Doppler-shift measuring sensors. For this challenging problem, we propose to use the probability hypothesis density (PHD) filter and present two implementations of the PHD filter, namely the sequential Monte Carlo PHD (SMC-PHD) and the Gaussian mixture PHD (GM-PHD) filters. Performances of both filters are carefully studied and compared for the considered challenging tracking problem. Simulation results show that both PHD filter implementations successfully track multiple targets using only Doppler shift measurements. Moreover, as a proof-of-concept, an experimental setup consisting of a network of microphones and a loudspeaker was prepared. Experimental study results reveal that it is possible to track multiple ground targets using acoustic Doppler shift measurements in a passive multi-static scenario. We observed that the GM-PHD is more effective, efficient and easy to implement than the SMC-PHD filter. {\textcopyright} 2014 Elsevier Inc.},
author = {Guldogan, Mehmet B. and Lindgren, David and Gustafsson, Fredrik and Habberstad, Hans and Orguner, Umut},
doi = {10.1016/j.dsp.2014.01.009},
file = {:home/itumeleng/Desktop/UCT/Papers/guldogan2014.pdf:pdf},
issn = {10512004},
journal = {Digital Signal Processing: A Review Journal},
keywords = {Doppler measurements,Gaussian mixture,Multi-target tracking,Probability hypothesis density filter,Random sets,Sequential Monte Carlo},
number = {1},
pages = {1--11},
publisher = {Elsevier Inc.},
title = {{Multi-target tracking with PHD filter using Doppler-only measurements}},
url = {http://dx.doi.org/10.1016/j.dsp.2014.01.009},
volume = {27},
year = {2014}
}

